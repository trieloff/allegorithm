; Hello, Allegorithm!
; The simplest program: a greeting and a demonstration of verdicts.

(println "Hello, Allegorithm!")
(println "")

; In this language, truth has four values, not two.
(println "true:    " true)
(println "false:   " false)
(println "both:    " both-verdict)
(println "neither: " neither-verdict)
